# =============================================================================
# Machine Troubleshooter — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =============================================================================

# --- Groq LLM ---
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# --- Supabase ---
# Find these in your Supabase project: Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Database connection string (Settings → Database → Connection string → URI)
DATABASE_URL=

# Storage bucket name for PDF manuals
SUPABASE_STORAGE_BUCKET=manuals

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# --- Reranker Model ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Model Cache ---
# Directory inside the container where HuggingFace models are cached
HF_HOME=/app/model_cache

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# --- Frontend (NEXT_PUBLIC_ prefix = safe for browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
