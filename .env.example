# =============================================================================
# Industrial AI Machine Troubleshooting System — Environment Example
# Copy this file to .env and fill in your keys: cp .env.example .env
# =============================================================================

# --- AI & LLM Inference (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=openai/gpt-oss-20b

# --- ElevenLabs Multilingual Voice AI (Marathi, Hindi, English) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=gHu9GtaHOXcSqFTK06ux
ELEVENLABS_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Web & OEM Bulletin Search (Optional) ---
SERPER_API_KEY=

# --- Vector Embeddings & Reranker ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HF_HOME=/app/model_cache

# --- EC2 Attached Volume & Persistence ---
# If you have attached an EBS volume to EC2, mount it (e.g. to /mnt/data) and set:
# DATA_VOLUME_PATH=/mnt/data
# For local development or default container storage, leave as .
DATA_VOLUME_PATH=.
MANUALS_DIR=/app/manuals
SQLITE_DB_PATH=/app/database/troubleshooter.db

# --- Supabase Cloud Sync (Optional — system falls back to local SQLite if offline) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=manuals
DATABASE_URL=

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# --- Frontend Networking ---
# Leave NEXT_PUBLIC_API_URL empty so client browsers use relative URLs (/api/*).
# Next.js will automatically proxy requests to BACKEND_URL via internal docker networking.
# This avoids "Upload failed: Failed to fetch" when accessing from EC2 IP.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
BACKEND_URL=http://backend:8000
